# SmartFlowPro Environment Variables
# Copy this file to .env and fill in your actual values

# ============ Supabase Configuration ============
# Required: Your Supabase project URL
# Format: https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Required: Supabase Anonymous Key (Public Key)
# Find this in your Supabase project settings under API
# This key is safe to expose in client-side code
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (Admin Key)
# Find this in your Supabase project settings under API
# ⚠️ WARNING: Never expose this key in client-side code!
# Only use for server-side operations or admin functions
# Leave empty if not needed for mobile app
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============ Environment ============
# Optional: Set environment (development, staging, production)
# Default: development
ENVIRONMENT=development

# ============ Feature Flags ============
# Optional: Use mock data instead of API calls (for development)
# Set to true to use mock data, false to use real API
USE_MOCK_DATA=false

# Optional: Enable debug logging
# Set to true for verbose logging, false for production
DEBUG=false
